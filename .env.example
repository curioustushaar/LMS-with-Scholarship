# Environment Variables Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git!

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=development
# Set to "production" for production deployment

# ==========================================
# SECURITY SETTINGS (Optional - Override defaults)
# ==========================================
# NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3001,https://yourdomain.com

# ==========================================
# RATE LIMITING (Optional - Override defaults)
# ==========================================
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000
# LOGIN_MAX_ATTEMPTS=5

# ==========================================
# IMPORTANT SECURITY NOTES:
# ==========================================
# 1. Never expose SUPABASE_SERVICE_ROLE_KEY to client
# 2. Only use NEXT_PUBLIC_ prefix for client-safe variables
# 3. Keep this file in .gitignore
# 4. Rotate keys regularly (quarterly recommended)
# 5. Use different keys for dev/staging/production
