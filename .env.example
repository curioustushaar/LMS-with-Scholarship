# Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git!

# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate a secure JWT secret with: openssl rand -base64 64
# Or use: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# Session configuration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ==========================================
# ENVIRONMENT
# ==========================================
NODE_ENV=development
# Set to "production" for production deployment

# ==========================================
# SECURITY SETTINGS
# ==========================================
# Allowed origins for CORS (comma-separated)
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# Rate limiting configuration
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Cookie settings
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# Password hashing
BCRYPT_ROUNDS=12

# ==========================================
# SUPERADMIN CREDENTIALS
# ==========================================
# Default superadmin account (CHANGE THESE!)
SUPERADMIN_EMAIL=superadmin@yourdomain.com
SUPERADMIN_PASSWORD=your-super-secure-password
SUPERADMIN_NAME=Super Administrator

# ==========================================
# APPLICATION SETTINGS
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ==========================================
# FILE UPLOAD LIMITS
# ==========================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf

# ==========================================
# IMPORTANT SECURITY NOTES:
# ==========================================
# 1. Never expose SUPABASE_SERVICE_ROLE_KEY to client
# 2. Only use NEXT_PUBLIC_ prefix for client-safe variables
# 3. Keep .env file in .gitignore (already configured)
# 4. Rotate JWT_SECRET regularly (quarterly recommended)
# 5. Use different keys for dev/staging/production
# 6. Set COOKIE_SECURE=true in production
# 7. Generate unique JWT_SECRET for each environment
# 8. Never commit .env file to version control
# 
# Generate JWT_SECRET:
# - Linux/Mac: openssl rand -base64 64
# - Windows: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# - Online: https://generate-secret.vercel.app/64
# ==========================================

